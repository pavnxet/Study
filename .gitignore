# .gitignore

# OS/editor files
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo

# Temporary/local files
*.tmp
*.temp
*.bak
*.orig
~$*

# Python/local tooling caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local environment/secrets
.env
.env.*
!.env.example

# Generated local output
coverage/
dist/
build/
